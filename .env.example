# DevPlane configuration - copy to .env and adjust. Never commit secrets.

APP_NAME=DevPlane
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Required outside development. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Explicit local-demo opt-in. Set false and use strong bootstrap passwords elsewhere.
DEMO_MODE=true
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# SQLite for local demos (default). For Postgres use:
# DATABASE_URL=postgresql+psycopg2://devplane:devplane@localhost:5432/devplane
DATABASE_URL=sqlite:///./data/devplane.db

REDIS_URL=redis://localhost:6379/0
PROVISIONING_DELAY_SECONDS=3

# Seeded accounts (change before any shared demo)
BOOTSTRAP_ADMIN_EMAIL=admin@devplane.local
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_DEV_EMAIL=dev@devplane.local
BOOTSTRAP_DEV_PASSWORD=dev123

# Ops registry integrations (optional; stubs are used when empty)
KUBECONFIG=
OPS_ALLOWED_NAMESPACES=default,devplane
JENKINS_URL=http://localhost:8080
JENKINS_USER=
JENKINS_TOKEN=
TERRAFORM_STATE_DIR=./terraform

# Optional Slack webhook for scripts/notify_stub.py
SLACK_WEBHOOK_URL=

# Observability credentials (Docker Compose)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
POSTGRES_PASSWORD=devplane

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
